      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let texto = $json.content[0].text.trim();\n\nconst asuntoMatch = texto.match(/ASUNTO:\\s*([\\s\\S]*?)(?=PREHEADER:|$)/i);\nconst preheaderMatch = texto.match(/PREHEADER:\\s*([\\s\\S]*?)(?=CUERPO:|$)/i);\nconst cuerpoMatch = texto.match(/CUERPO:\\s*([\\s\\S]*)/i);\n\nreturn {\n  asunto: asuntoMatch ? asuntoMatch[1].trim() : '',\n  preheader: preheaderMatch ? preheaderMatch[1].trim() : '',\n  cuerpo: cuerpoMatch ? cuerpoMatch[1].trim() : ''\n};"
      },
